{
  "manifest_version": 3,
  "name": "Hearth — LinkedIn capture",
  "version": "1.0.0",
  "description": "Save the LinkedIn profile you're viewing — photo included — into your Hearth personal CRM.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://www.linkedin.com/*", "https://media.licdn.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hearth capture"
  }
}
